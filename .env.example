# ── Core ────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token
OWNER_ID=your-discord-user-id
# Optional: register slash commands instantly to one guild while testing
GUILD_ID=
# Text-command prefix (slash commands always work too)
PREFIX=?
# Prefix commands need Discord's privileged "Message Content" intent (enable it
# under Bot in the Developer Portal). It is restricted once a bot reaches 100+
# servers. Set this to false to disable prefix commands and run slash-only.
ENABLE_PREFIX_COMMANDS=true
DEBUG=false

# ── Dashboard ───────────────────────────────────────
DASHBOARD_PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL of the dashboard (no trailing slash). Used to build the
# OAuth2 redirect URI: <DASHBOARD_URL>/auth/discord/callback
DASHBOARD_URL=http://localhost:3000

# ── Discord OAuth2 (dashboard login) ────────────────
# From the Discord Developer Portal → your application → OAuth2.
# Add this exact redirect URL there: <DASHBOARD_URL>/auth/discord/callback
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-application-client-secret

# ── Twitch live notifications (optional) ────────────
# YouTube, Reddit and Kick notifications need no keys. Twitch does:
#   1. Go to https://dev.twitch.tv/console/apps and log in.
#   2. Click "Register Your Application". Name it anything, set the OAuth
#      Redirect URL to http://localhost, category "Application Integration".
#   3. Copy the Client ID, then "New Secret" for the Client Secret, below.
# Leave blank to keep Twitch notifications disabled.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
